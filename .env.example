# Runtime mode. Choose 'development', 'production', or enable demo mode for preview deployments.
APP_MODE=development

# Enable demo mode on Vercel preview/staging (in-memory store, demo logins enabled without PostgreSQL)
# Set to 'true' on Vercel if deploying without a live PostgreSQL database:
ENABLE_DEMO_MODE=false

# PostgreSQL database connection (required outside demo mode)
DATABASE_URL=postgresql://intila9a:change-me@localhost:5432/intila9a?schema=public

# Pepper secret for hashing session tokens (32+ random characters)
SESSION_PEPPER=replace-with-a-long-random-secret

# Application public URL, required for production/email links and origin verification
APP_URL=http://localhost:3000

# Password reset expiry (minutes); 20 is the default
PASSWORD_RESET_TTL_MINUTES=20

# Private Object storage (S3 / MinIO / AWS S3) for production lesson PDF files
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=intila9a-private
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

